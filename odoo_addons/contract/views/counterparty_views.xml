<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_contract_counterparty_tree" model="ir.ui.view">
    <field name="name">contract.counterparty.tree</field>
    <field name="model">contract.counterparty</field>
    <field name="arch" type="xml">
      <tree string="相对方 / 签约主体">
        <field name="name"/>
        <field name="role"/>
        <field name="contact"/>
        <field name="phone"/>
      </tree>
    </field>
  </record>

  <record id="view_contract_counterparty_form" model="ir.ui.view">
    <field name="name">contract.counterparty.form</field>
    <field name="model">contract.counterparty</field>
    <field name="arch" type="xml">
      <form string="相对方 / 签约主体">
        <sheet>
          <group>
            <field name="name"/>
            <field name="role"/>
            <field name="contact"/>
            <field name="phone"/>
            <field name="email"/>
          </group>
          <group string="关联合同">
            <field name="contract_ids">
              <tree>
                <field name="contract_name"/>
                <field name="contract_type"/>
                <field name="amount"/>
                <field name="status"/>
              </tree>
            </field>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
