<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 权限组（考核 C：自建权限组） -->
  <record id="module_category_contract" model="ir.module.category">
    <field name="name">合同管理</field>
  </record>
  <record id="group_contract_manager" model="res.groups">
    <field name="name">合同管理员</field>
    <field name="category_id" ref="module_category_contract"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <!-- 管理员（admin）默认拥有合同管理权限，否则只有只读、无「新建」按钮 -->
  <record id="base.user_admin" model="res.users">
    <field name="groups_id" eval="[(4, ref('group_contract_manager'))]"/>
  </record>
</odoo>
